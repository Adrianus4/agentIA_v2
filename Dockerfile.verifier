# Verifier agent image: Python service + JDK 21 + Maven, runs `mvn test` on the files it receives.
FROM maven:3.9-eclipse-temurin-21 AS jdk_maven
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PORT=8001 \
    SERVICE_MODULE=services.verifier_service:app \
    UVICORN_EXTRA= \
    VERIFIER_RUNNER=host \
    VERIFIER_SCRATCH_DIR=/data/verify \
    JAVA_HOME=/opt/java/openjdk \
    MAVEN_HOME=/usr/share/maven \
    PATH="/opt/java/openjdk/bin:/usr/share/maven/bin:${PATH}"

WORKDIR /app

COPY --from=jdk_maven /opt/java/openjdk /opt/java/openjdk
COPY --from=jdk_maven /usr/share/maven /usr/share/maven
RUN ln -sf /usr/share/maven/bin/mvn /usr/local/bin/mvn

COPY requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY app ./app
COPY services ./services
COPY contracts ./contracts
COPY agents ./agents
COPY profiles ./profiles
COPY templates ./templates
COPY scripts/start.sh ./scripts/start.sh
COPY scripts/warm_maven_cache.sh ./scripts/warm_maven_cache.sh

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /data/verify /home/appuser/.m2/repository \
    && chown -R appuser:appuser /app /data /home/appuser \
    && chmod +x /app/scripts/start.sh /app/scripts/warm_maven_cache.sh

USER appuser

EXPOSE 8001

ENTRYPOINT ["/app/scripts/start.sh"]
