# Copy to .env. Read by start.sh / start.bat (KEY=VALUE) and by docker compose (--env-file .env).

# --- LLM (pick one provider) ----------------------------------------------------------
# Gemini (default when GEMINI_API_KEY is set)
GEMINI_API_KEY=
# LLM_PROVIDER=gemini | local | openai   (empty: gemini if a key exists, otherwise local)
LLM_PROVIDER=
# Optional model override; empty uses the provider default
# (gemini-flash-latest, qwen2.5-coder:7b, gpt-4o-mini)
LLM_MODEL=
# Local Ollama / llama.cpp (OpenAI-compatible) for start.sh / start.bat
# (containers use CONTAINER_LOCAL_LLM_ENDPOINT, default http://host.docker.internal:11434)
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_API_BASE=

# --- Orchestrator ------------------------------------------------------------------------
# Key the Web Studio sends as x-api-key (configure the same value in the UI settings)
ORCHESTRATOR_API_KEY=secret
# Repairs per run (0-3)
AGENTIA_MAX_REPAIR_ATTEMPTS=3

# --- Ports (local launchers) -------------------------------------------------------------
# PORT=8000
# FRONTEND_PORT=3000
# VERIFIER_PORT=8001
# REPAIR_PORT=8002
# VALIDATOR_PORT=8003
# GENERATOR_PORT=8004

# --- Ports (docker compose / Openship) ---------------------------------------------------
# ORCHESTRATOR_PORT=8000
# WEB_PORT=3000
